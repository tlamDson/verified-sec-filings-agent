# Copy to .env and fill in. .env is git-ignored; never commit a real contact.

# SEC requires "Name email" on every automated request (https://www.sec.gov/os/accessing-edgar-data).
# Put your own real contact in .env; the value below is a placeholder.
SEC_USER_AGENT="Your Name your-name@example.com"
# Raw cache of SEC responses (git-ignored). Default: data/raw
# SEC_RAW_CACHE_DIR=data/raw

# Local Postgres from compose.yaml
POSTGRES_USER=sec
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sec
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sec:change-me-local-only@localhost:5432/sec

# LLM providers, tried in order (JSON list). Unset: one local llama.cpp server at
# http://127.0.0.1:8080/v1, which costs nothing. Only free endpoints belong here (cost cap $0).
# A key is never written in the list: "api_key_env" names the variable that holds it.
# LLM_PROVIDERS='[{"name":"hosted","base_url":"https://llm.example.com/v1","model":"model-name","api_key_env":"HOSTED_LLM_KEY","limits":{"requests_per_minute":30,"requests_per_day":1000}},{"name":"local","base_url":"http://127.0.0.1:8080/v1","model":"local"}]'
# HOSTED_LLM_KEY=

# Phoenix (OpenTelemetry traces)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
