# Copy to .env and fill in. .env is git-ignored; never commit a real contact.

# SEC requires "Name email" on every automated request (https://www.sec.gov/os/accessing-edgar-data).
# Put your own real contact in .env; the value below is a placeholder.
SEC_USER_AGENT="Your Name your-name@example.com"
# Raw cache of SEC responses (git-ignored). Default: data/raw
# SEC_RAW_CACHE_DIR=data/raw

# Local Postgres from compose.yaml
POSTGRES_USER=sec
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sec
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sec:change-me-local-only@localhost:5432/sec

# Phoenix (OpenTelemetry traces)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
