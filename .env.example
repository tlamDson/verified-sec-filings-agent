# Copy to .env and fill in. .env is git-ignored; never commit a real contact.

# SEC requires "Name email" on every automated request (https://www.sec.gov/os/accessing-edgar-data).
# Put your own real contact in .env; the value below is a placeholder.
SEC_USER_AGENT="Your Name your-name@example.com"
# Raw cache of SEC responses (git-ignored). Default: data/raw
# SEC_RAW_CACHE_DIR=data/raw

# Local Postgres from compose.yaml
POSTGRES_USER=sec
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sec
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sec:change-me-local-only@localhost:5432/sec

# LLM providers, tried in order (JSON list). Unset: one local llama.cpp server at
# http://127.0.0.1:8080/v1, which costs nothing. Only free endpoints belong here (cost cap $0).
# A key is never written in the list: "api_key_env" names the variable that holds it.
# LLM_PROVIDERS='[{"name":"hosted","base_url":"https://llm.example.com/v1","model":"model-name","api_key_env":"HOSTED_LLM_KEY","limits":{"requests_per_minute":30,"requests_per_day":1000}},{"name":"local","base_url":"http://127.0.0.1:8080/v1","model":"local"}]'
# HOSTED_LLM_KEY=

# API (`sec-agent api serve`) and web app. The web app signs every call to the API with
# this secret; both sides need the same value, 32 characters or more. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# A value that still starts with "change-me" is refused.
API_AUTH_SECRET=change-me-to-a-random-secret-of-32-or-more-characters
# Questions one user may ask per UTC day. Default: 20
# API_DAILY_QUESTIONS=20
# Where the web app's server reaches the API.
API_BASE_URL=http://127.0.0.1:8000

# Web app sign-in (Auth.js / next-auth). The web app reads these from web/.env.local.
NEXTAUTH_SECRET=change-me-to-another-random-secret
NEXTAUTH_URL=http://localhost:3000
# OAuth for real users: a provider is offered when both its id and its secret are set.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Simulated test accounts sim-01@example.com to sim-50@example.com: cohort "simulated",
# always labelled and counted apart from real users. Off unless this shared password is set.
# SIM_LOGIN_SECRET=change-me-to-a-password-for-the-simulated-accounts

# Phoenix (OpenTelemetry traces over OTLP HTTP, at /v1/traces). Unset: no export.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# Also append every span to a JSONL file, for `sec-agent traces table` (git-ignored path).
# SEC_AGENT_TRACE_FILE=data/traces/spans.jsonl
